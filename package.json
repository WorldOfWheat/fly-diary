{
  "name": "fly-diary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "test": "node --test \"tests/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/*.test.js\"",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "coverage:rust": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --summary-only",
    "coverage": "npm run test:coverage && npm run coverage:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
