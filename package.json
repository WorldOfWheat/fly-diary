{
  "name": "fly-diary",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "coverage:rust": "cargo llvm-cov --locked --manifest-path src-tauri/Cargo.toml --summary-only",
    "coverage": "pnpm run test:coverage && pnpm run coverage:rust",
    "audit:npm": "pnpm audit --audit-level high",
    "audit:rust": "cargo audit --file src-tauri/Cargo.lock"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4"
  }
}
